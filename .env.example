# ===========================================
# GoMailServer Configuration
# ===========================================
# Single binary mail server with integrated web UI
# All settings can be overridden via environment variables

# ===========================================
# Server
# ===========================================
SERVER_HOSTNAME=localhost
SERVER_DOMAIN=

# ===========================================
# Web UI (Admin Panel + Webmail)
# ===========================================
WEBUI_ENABLED=true
WEBUI_PORT=8080

# ===========================================
# Admin API
# ===========================================
API_PORT=8980
API_READ_TIMEOUT=15
API_WRITE_TIMEOUT=15
# API_JWT_SECRET=your-secret-key-here
# API_CORS_ORIGINS=http://localhost:3000

# ===========================================
# WebDAV (CalDAV/CardDAV)
# ===========================================
WEBDAV_ENABLED=true
WEBDAV_PORT=8800
WEBDAV_READ_TIMEOUT=30
WEBDAV_WRITE_TIMEOUT=30

# ===========================================
# SMTP
# ===========================================
SMTP_HOSTNAME=localhost
SMTP_SUBMISSION_PORT=587
SMTP_RELAY_PORT=25
SMTPS_PORT=465
SMTP_MAX_MESSAGE_SIZE=52428800

# ===========================================
# IMAP
# ===========================================
IMAP_PORT=143
IMAPS_PORT=993
IMAP_IDLE_TIMEOUT=1800

# ===========================================
# Database
# ===========================================
DB_DRIVER=sqlite3
DB_SQLITE_PATH=./data/mailserver.db
DB_SQLITE_WAL_ENABLED=true

# PostgreSQL (alternative to SQLite)
# DB_DRIVER=postgres
# DB_POSTGRES_HOST=localhost
# DB_POSTGRES_PORT=5432
# DB_POSTGRES_DATABASE=gomailserver
# DB_POSTGRES_USER=gomailserver
# DB_POSTGRES_PASSWORD=
# DB_POSTGRES_SSL_MODE=disable

# ===========================================
# TLS
# ===========================================
# Options: self-signed (dev), acme (production), manual
TLS_CERT_FILE=
TLS_KEY_FILE=

# ACME/Let's Encrypt
ACME_ENABLED=false
ACME_EMAIL=
ACME_PROVIDER=cloudflare
# CLOUDFLARE_API_TOKEN=

# ===========================================
# Logging
# ===========================================
# Levels: debug, info, warn, error
LOG_LEVEL=info
# Formats: json, text
LOG_FORMAT=json

# ===========================================
# DNS Resolver (for DANE, MTA-STS, SPF, DKIM)
# ===========================================
DNS_RESOLVER=1.1.1.1:53
DNS_TIMEOUT=5
DNS_USE_TCP=false

# ===========================================
# Security Services (Optional)
# ===========================================
# ClamAV Antivirus
CLAMAV_SOCKET_PATH=/var/run/clamav/clamd.ctl
CLAMAV_TIMEOUT=60

# SpamAssassin
SPAMASSASSIN_HOST=localhost
SPAMASSASSIN_PORT=783
SPAMASSASSIN_TIMEOUT=30
